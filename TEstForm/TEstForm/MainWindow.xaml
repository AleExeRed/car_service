<Window x:Class="TEstForm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TEstForm"
        mc:Ignorable="d"
        Title="Поликлиника" Height="450" Width="800">
    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *, *" >
        <Label Content="Simple text" FontSize="24" Grid.Row="0" Grid.Column="0"/>
        <Button x:Name="AddAppointment" Content="Добавить запись" Grid.Row="2" Grid.Column="2"/>
        <DataGrid Grid.Row="1" Grid.Column="0" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="3"/>
    </Grid>
</Window>
